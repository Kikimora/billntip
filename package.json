  "scripts": {
    "out-dir": "cat tsconfig.json | npx  jsonc-cli read '[\"compilerOptions\", \"outDir\"]' | tr -d '\"'",
    "aws-sso": "aws sso login --profile ",
    "compile": "npx tsc && cp .env $(npm run --silent out-dir)/.env",
    "test": "cd $(npm run --silent out-dir) && npx jest",
    "infra": "pulumi --cwd ./$(npm run --silent out-dir)/infra up",
    "build": "cd $(npm run --silent out-dir) && npx node build -- -b -u -p -s dev "
